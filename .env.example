# Asset Distribution System — Environment Variables
# Copy this file to .env and fill in your values.

# ─── Django ──────────────────────────────────────────────
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=1
# Comma-separated, e.g. "example.com,www.example.com"
DJANGO_ALLOWED_HOSTS=*

# ─── Signup gate ─────────────────────────────────────────
# Anyone with this code can create an account on the signup page.
SIGNUP_INVITE_CODE=reviresco

# ─── Optional: bootstrap an initial admin user ───────────
# These are only read by `python manage.py setup_initial_data`.
# If left blank, the command will skip creating a superuser.
ASSET_ADMIN_USERNAME=
ASSET_ADMIN_PASSWORD=
ASSET_ADMIN_EMAIL=
# Branch code for the bootstrap admin: A=Lynn, B=Richard, C=Rob
ASSET_ADMIN_BRANCH=A

# ─── Email (Google SMTP) ─────────────────────────────────
# Used for self-service password reset and assignment notifications.
# Leave EMAIL_HOST_PASSWORD blank to fall back to the console backend
# (emails will be printed to the terminal instead of sent).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=your-account@gmail.com
# Use a Google App Password, NOT your normal account password.
# https://myaccount.google.com/apppasswords  (requires 2FA enabled)
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Asset Distribution <your-account@gmail.com>
